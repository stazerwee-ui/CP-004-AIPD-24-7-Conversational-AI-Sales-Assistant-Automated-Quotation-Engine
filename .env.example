# ==========================================================
# Solace Dignity Care — environment configuration
#
# Copy this file to .env and fill in your own values:
#     copy .env.example .env      (Windows)
#
# .env is listed in .gitignore and must never be committed.
# ==========================================================

# ----------------------------------------------------------
# Admin / director console access token
# ----------------------------------------------------------
# Required to reach the staff console and the secure document
# endpoints (/api/admin/*). Choose any value you like — this
# is the token you will type into the Director & Staff Portal
# login prompt.
#
# Generate a strong one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SOLACE_ADMIN_TOKEN=change_me_before_running

# ----------------------------------------------------------
# Local Ollama connection
# ----------------------------------------------------------
# The base URL of the Ollama service and the model to use.
# Ollama runs as a background service on Windows; these
# defaults are correct for a standard install.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# ----------------------------------------------------------
# Server binding
# ----------------------------------------------------------
# 0.0.0.0 allows access from a phone on the same Wi-Fi.
# Use 127.0.0.1 to restrict to this machine only.
APP_HOST=127.0.0.1
APP_PORT=8000
